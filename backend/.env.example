# === Required ===
JWT_SECRET_KEY=          # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# === Optional (defaults shown) ===
API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=true

BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000"]

# Optional Google Ads credentials. Requests choose platform per campaign.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_REFRESH_TOKEN=

# Optional Meta Ads credentials. The app can run with only Meta or only Google configured.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# AI Model Configuration
# Supported providers: gemini, openai, anthropic, lm_studio, mock
MODEL_PROVIDER=gemini
# For gemini: gemini-3.5-flash, etc.
# For lm_studio: zai-org/glm-4.7-flash (or other model loaded locally)
MODEL_NAME=gemini-3.5-flash
API_KEY=

# Optional: Custom URL for local LM Studio instance (defaults to http://localhost:1234/v1)
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

MAX_TOKENS=1000
TEMPERATURE=0.7

DATABASE_URL=
